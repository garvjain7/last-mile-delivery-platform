# Environment variables template for database, redis, and service credentials.
# Copy to .env for local runtime configuration.

# Database Configuration (Neon DB / PostgreSQL 15 + PostGIS 3.3)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lastMileDB
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_COMMAND_TIMEOUT=5.0
# Neon DB connection URL override (e.g. postgresql+asyncpg://user:pass@ep-xyz.neon.tech/lastMileDB?sslmode=require)
DATABASE_URL=

# Redis Configuration (Render Redis / Cloud Redis)
# Connection URL override for Render Redis (e.g. rediss://default:password@red-xyz.oregon-redis.render.com:6379)
REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0

# MinIO Storage Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000

# External Routing & Geocoding Engine URLs & Timeouts
OSRM_URL=http://osrm:5000
OSRM_CONNECT_TIMEOUT=3.0
OSRM_READ_TIMEOUT=10.0
OSRM_WRITE_TIMEOUT=5.0

VROOM_URL=http://vroom:3000
VROOM_CONNECT_TIMEOUT=3.0
VROOM_READ_TIMEOUT=15.0
VROOM_WRITE_TIMEOUT=5.0

NOMINATIM_URL=http://nominatim:8080
NOMINATIM_CONNECT_TIMEOUT=3.0
NOMINATIM_READ_TIMEOUT=10.0

# Security Credentials (Required — fail fast if unset in production)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Service Ports
CORE_API_PORT=8000
CONTROL_TOWER_PORT=8001
DRIVER_GATEWAY_PORT=8002

# Simulator Parameters
NUM_VIRTUAL_DRIVERS=5
ORDER_GENERATION_RATE_SEC=10
