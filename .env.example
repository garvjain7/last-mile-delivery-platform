# Cleaned & Normalized Environment Variables Template
# Copy to .env for local runtime configuration

# Primary Connection URLs (Neon DB & Render Key-Value Valkey 8 / Redis)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lastMileDB
REDIS_URL=redis://localhost:6379

# Database Connection Pool Settings (Optimized for Neon DB Free Tier Compute Auto-Suspend)
POSTGRES_POOL_SIZE=2
POSTGRES_MAX_OVERFLOW=3

# Storage & Engine Service Endpoints
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

OSRM_URL=http://localhost:5000
VROOM_URL=http://localhost:3000
NOMINATIM_URL=http://localhost:8080

# Security Credentials (Required — fail fast if unset in production)
JWT_SECRET_KEY=supersecretkey_change_in_production
JWT_ALGORITHM=HS256

# World Simulator Configuration
NUM_VIRTUAL_DRIVERS=5
ORDER_GENERATION_RATE_SEC=10
