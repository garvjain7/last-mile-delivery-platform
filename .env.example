# Environment variable layout for the unified runtime.
# Copy to .env and fill values for your environment.

# Primary connection URLs
DATABASE_URL=
REDIS_URL=

# Database connection pool settings
POSTGRES_POOL_SIZE=
POSTGRES_MAX_OVERFLOW=

# Storage and routing engine endpoints
MINIO_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
OSRM_URL=
VROOM_URL=
NOMINATIM_URL=

# Security credentials
JWT_SECRET_KEY=
JWT_ALGORITHM=

# SMTP for password-reset emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Public base URL embedded in password-reset email links
PUBLIC_BASE_URL=
COOKIE_SECURE=

# Unified runtime host and port
HOST=
PORT=

# World simulator configuration
CORE_API_URL=
DRIVER_GATEWAY_URL=
NUM_VIRTUAL_DRIVERS=
ORDER_GENERATION_RATE_SEC=
