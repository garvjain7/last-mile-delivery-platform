# Cleaned & Normalized Environment Variables Template
# Copy to .env for local runtime configuration

# Primary Connection URLs (Neon DB & Render Key-Value Valkey 8 / Redis)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lastMileDB
# Neon example:
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>.<region>.aws.neon.tech/<database>?ssl=require
REDIS_URL=redis://localhost:6379
CORE_API_URL=http://localhost:8000

# Storage & Engine Service Endpoints
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

OSRM_URL=http://localhost:5000
VROOM_URL=http://localhost:3000
NOMINATIM_URL=http://localhost:8080

# Security Credentials (Required — fail fast if unset in production)
JWT_SECRET_KEY=supersecretkey_change_in_production
JWT_ALGORITHM=HS256

# SMTP — used by core-api to send password-reset emails.
# Use an app password (not your account password) for SMTP_PASSWORD.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Public base URL of core-api — embedded in password-reset email links.
# In production this is your Render service URL.
PUBLIC_BASE_URL=http://localhost:8000

# Set to true in production so cookies are only sent over HTTPS.
COOKIE_SECURE=false
DRIVER_APP_ORIGINS=http://localhost:8765

# World Simulator Configuration
NUM_VIRTUAL_DRIVERS=5
ORDER_GENERATION_RATE_SEC=10
